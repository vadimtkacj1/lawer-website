# Email Configuration - SMTP Server Settings
# SMTP server host (e.g., mail.privateemail.com, smtp.gmail.com)
EMAIL_SERVER_HOST=mail.privateemail.com

# SMTP server port (usually 465 for SSL, 587 for TLS)
EMAIL_SERVER_PORT=465

# SMTP username (usually your email address)
EMAIL_SERVER_USER=assistant@avi-mashkanta.com

# SMTP password
EMAIL_SERVER_PASSWORD=your-password-here

# Email address that will receive contact form submissions
EMAIL_TO=vadim.tkach1378@gmail.com

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# CRM lead forwarding (Aiterra CRM) — leads are forwarded here alongside the email
# Public lead-capture endpoint of your CRM (absolute URL)
CRM_LEADS_ENDPOINT=https://aiterra.agency/api/site-leads/submit
# Public token from the CRM "Site integration" tab (identifies your account; safe to expose server-side)
CRM_PUBLIC_TOKEN=your-crm-public-token-here
